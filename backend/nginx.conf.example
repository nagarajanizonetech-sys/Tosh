# ==============================================================================
# Nginx Reverse Proxy Configuration for Tosh Clinic HMS API
# Target Host: apitosh.risingsuntech.in
# Backend Service: FastAPI / Uvicorn running on 127.0.0.1:8000
# ==============================================================================

# 1. Connection Upgrade Mapping for WebSockets (Put this inside the `http {}` block
#    or at the top of your site file if included inside http)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 2. Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name apitosh.risingsuntech.in;

    return 301 https://$host$request_uri;
}

# 3. Main HTTPS Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name apitosh.risingsuntech.in;

    # SSL Certificates (Uncomment and set paths if using Certbot / Let's Encrypt)
    # ssl_certificate /etc/letsencrypt/live/apitosh.risingsuntech.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/apitosh.risingsuntech.in/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Maximum file upload size (matches backend 25-30MB file size limit)
    client_max_body_size 30M;

    # Root location (covers all REST APIs and WebSocket endpoints)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket support headers (CRITICAL for wss:// connection to succeed)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Forward real client information
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket Keepalive & Timeout settings (prevents dropping idle connections)
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;

        # Buffer settings
        proxy_buffering off;
    }
}

