# ========================================================
# Tosh Clinic HMS — Monorepo Git Ignore Rules
# ========================================================

# --- Environment, Secrets & Credentials ---
.env
.env.*
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
backend/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Testing, Coverage & Linters ---
.pytest_cache/
.coverage
htmlcov/
coverage/
frontend/coverage/
.mypy_cache/
.ruff_cache/
test-results/
playwright-report/
powershell.cmd

# --- Uploads, Storage & Temporary Data ---
uploads/
backend/uploads/
storage/
scratch/
backend/scratch/
*.tmp
*.temp

# --- Databases & Local Dumps ---
*.sqlite
*.sqlite3
*.db

# --- IDE, Editors & OS ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
